---
/**
 * Site header, calmer than Starlight's default:
 * - the logo with a "Docs" label, so it's clear which Leantime site you're on, and the Leantime
 *   version the docs describe (src/lib/version.ts), linking to its release notes;
 * - a compact search button on the right instead of a wide search bar. It opens the same
 *   search dialog, with ⌘K / Ctrl+K and "/" as shortcuts;
 * - theme and text style together behind one "Display" button;
 * - a "Star" button with the repository's star count (src/lib/stars.ts). GitHub and Discord
 *   are also in the mobile menu.
 */
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { REPO_URL, STARS, STARS_SHORT } from '../lib/stars';
import { RELEASE_URL, SHORT_VERSION } from '../lib/version';

---

<div class="lt-header">
	<div class="lt-brand">
		<SiteTitle />
		<span class="lt-docs-label" aria-hidden="true">Docs</span>
		<a
			class="lt-version"
			href={RELEASE_URL}
			title={`Docs for Leantime ${SHORT_VERSION}. See what's new in this release.`}
			aria-label={`Docs for Leantime ${SHORT_VERSION}: release notes`}
		>
			{SHORT_VERSION}
		</a>
	</div>

	<div class="lt-tools print:hidden">
		<div class="lt-search">
			<Search />
		</div>

		<details class="lt-display sl-hidden md:sl-block">
			<summary aria-label="Display settings: theme and text style" title="Display settings">
				<Icon name="setting" size="1.1rem" />
				<span class="lt-display-label">Display</span>
			</summary>
			<div class="lt-display-panel">
				<p class="lt-display-title">Display</p>
				<ThemeSelect />
			</div>
		</details>

		<a
			class="lt-star sl-hidden md:sl-flex"
			href={REPO_URL}
			title="Star Leantime on GitHub"
			aria-label={STARS ? `Star Leantime on GitHub, ${STARS.toLocaleString('en-US')} stars` : 'Star Leantime on GitHub'}
		>
			<Icon name="github" size="1rem" />
			<span class="lt-star-label">Star</span>
			{STARS_SHORT && <span class="lt-star-count">{STARS_SHORT}</span>}
		</a>
	</div>
</div>

<script>
	// "/" opens search too, unless you're typing somewhere.
	window.addEventListener('keydown', (event) => {
		if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
		const target = event.target as HTMLElement | null;
		if (target?.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return;
		const open = document.querySelector<HTMLButtonElement>('.lt-search button[data-open-modal]');
		if (!open || open.disabled) return;
		event.preventDefault();
		open.click();
	});

	// The Display panel closes on Escape and when you click elsewhere.
	const display = document.querySelector<HTMLDetailsElement>('details.lt-display');
	if (display) {
		document.addEventListener('click', (event) => {
			if (display.open && !display.contains(event.target as Node)) display.open = false;
		});
		display.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && display.open) {
				display.open = false;
				display.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	.lt-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}

	.lt-brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
		min-width: 0;
	}
	.lt-docs-label {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		padding-inline-start: 0.6rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		line-height: 1.4;
	}

	/* The version: a quiet pill next to "Docs". Hidden where the header gets crowded. */
	.lt-version {
		padding: 0.05rem 0.45rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.5;
		text-decoration: none;
		font-variant-numeric: tabular-nums;
	}
	.lt-version:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	@media (max-width: 22rem) {
		.lt-version {
			display: none;
		}
	}

	.lt-tools {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-inline-start: auto;
	}

	/* Search: a compact button instead of a wide bar. It still opens Starlight's search dialog. */
	@media (min-width: 50rem) {
		.lt-search :global(button[data-open-modal]) {
			width: auto;
			max-width: none;
			height: 2.25rem;
			gap: 0.5rem;
			padding-inline: 0.65rem 0.4rem;
			border-radius: 999px;
			background-color: transparent;
		}
		.lt-search :global(button[data-open-modal] > :last-child) {
			margin-inline-start: 0.25rem;
		}
	}

	/* Display: theme and text style behind one button. */
	.lt-display {
		position: relative;
	}
	.lt-display summary {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		padding-inline: 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}
	.lt-display summary::-webkit-details-marker {
		display: none;
	}
	.lt-display summary:hover,
	.lt-display[open] summary {
		border-color: var(--sl-color-gray-2);
		color: var(--sl-color-white);
	}
	.lt-display summary:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.lt-display-panel {
		position: absolute;
		inset-inline-end: 0;
		top: calc(100% + 0.5rem);
		z-index: 10;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 12rem;
		padding: 0.75rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background-color: var(--sl-color-bg-nav);
		box-shadow: var(--sl-shadow-md);
	}
	.lt-display-title {
		margin: 0;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}

	/* Star on GitHub: a pill like Display, with the star count after a divider. */
	.lt-star {
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		padding-inline: 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		white-space: nowrap;
	}
	.lt-star:hover {
		border-color: var(--sl-color-gray-2);
		color: var(--sl-color-white);
	}
	.lt-star-count {
		padding-inline-start: 0.5rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	/* Between tablet and wide screens: icon-only Display button to leave room. */
	@media (max-width: 60rem) {
		.lt-display-label,
		.lt-star-label {
			display: none;
		}
	}
</style>
