---
/**
 * Site header, calmer than Starlight's default:
 * - the logo with a "Docs" label, so it's clear which Leantime site you're on;
 * - the five colour-coded sections as links, with the one you're in marked (wide screens only;
 *   on smaller screens they're in the sidebar);
 * - a compact search button on the right instead of a wide search bar. It opens the same
 *   search dialog, with ⌘K / Ctrl+K and "/" as shortcuts;
 * - theme and text style together behind one "Display" button, then GitHub and Discord.
 */
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { sectionOf, type SectionKey } from '../lib/sections';

const { entry, id } = Astro.locals.starlightRoute;
const current = id ? sectionOf(id, entry.data.section as SectionKey | undefined) : undefined;

const pages = new Set((await getCollection('docs')).map((page) => page.id));
/** The first page of each section that exists (the AI overview arrives with the ai/ pages). */
const firstExisting = (...ids: string[]) => ids.find((page) => pages.has(page));

const sections: Array<{ key: SectionKey; label: string; page: string | undefined }> = [
	{ key: 'install', label: 'Self-hosting', page: firstExisting('installation/installation-types') },
	{ key: 'use', label: 'Using Leantime', page: firstExisting('getting-started/new-project', 'using-leantime/task-management') },
	{ key: 'ai', label: 'AI', page: firstExisting('ai', 'installation/leantime-mcp') },
	{ key: 'learn', label: 'Knowledge base', page: firstExisting('knowledge-base/wheretostart') },
	{ key: 'dev', label: 'Developers', page: firstExisting('api/usage', 'development/plugin-development') },
];
---

<div class="lt-header">
	<div class="lt-brand">
		<SiteTitle />
		<span class="lt-docs-label" aria-hidden="true">Docs</span>
	</div>

	<nav class="lt-sections print:hidden" aria-label="Sections">
		<ul>
			{
				sections
					.filter((section) => section.page)
					.map((section) => (
						<li>
							<a
								href={`/${section.page}/`}
								data-section={section.key}
								aria-current={section.key === current ? 'true' : undefined}
							>
								<span class="lt-dot" aria-hidden="true" />
								{section.label}
							</a>
						</li>
					))
			}
		</ul>
	</nav>

	<div class="lt-tools print:hidden">
		<div class="lt-search">
			<Search />
		</div>

		<details class="lt-display sl-hidden md:sl-block">
			<summary aria-label="Display settings: theme and text style" title="Display settings">
				<Icon name="setting" size="1.1rem" />
				<span class="lt-display-label">Display</span>
			</summary>
			<div class="lt-display-panel">
				<p class="lt-display-title">Display</p>
				<ThemeSelect />
			</div>
		</details>

		<div class="lt-social sl-hidden md:sl-flex">
			<SocialIcons />
		</div>
	</div>
</div>

<script>
	// "/" opens search too, unless you're typing somewhere.
	window.addEventListener('keydown', (event) => {
		if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
		const target = event.target as HTMLElement | null;
		if (target?.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return;
		const open = document.querySelector<HTMLButtonElement>('.lt-search button[data-open-modal]');
		if (!open || open.disabled) return;
		event.preventDefault();
		open.click();
	});

	// The Display panel closes on Escape and when you click elsewhere.
	const display = document.querySelector<HTMLDetailsElement>('details.lt-display');
	if (display) {
		document.addEventListener('click', (event) => {
			if (display.open && !display.contains(event.target as Node)) display.open = false;
		});
		display.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && display.open) {
				display.open = false;
				display.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	.lt-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}

	.lt-brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
		min-width: 0;
	}
	.lt-docs-label {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		padding-inline-start: 0.6rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		line-height: 1.4;
	}

	/* Section links: wide screens only. */
	.lt-sections {
		display: none;
	}
	@media (min-width: 72rem) {
		.lt-sections {
			display: block;
			margin-inline-start: 1rem;
		}
	}
	.lt-sections ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.lt-sections a {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.lt-sections a:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}
	.lt-sections .lt-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background-color: var(--lt-accent);
		opacity: 0.55;
	}
	.lt-sections a[aria-current='true'] {
		color: var(--lt-accent);
		background-color: color-mix(in srgb, var(--lt-accent) 12%, transparent);
	}
	.lt-sections a[aria-current='true'] .lt-dot {
		opacity: 1;
	}

	.lt-tools {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-inline-start: auto;
	}

	/* Search: a compact button instead of a wide bar. It still opens Starlight's search dialog. */
	@media (min-width: 50rem) {
		.lt-search :global(button[data-open-modal]) {
			width: auto;
			max-width: none;
			height: 2.25rem;
			gap: 0.5rem;
			padding-inline: 0.65rem 0.4rem;
			border-radius: 999px;
			background-color: transparent;
		}
		.lt-search :global(button[data-open-modal] > :last-child) {
			margin-inline-start: 0.25rem;
		}
	}

	/* Display: theme and text style behind one button. */
	.lt-display {
		position: relative;
	}
	.lt-display summary {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		padding-inline: 0.65rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}
	.lt-display summary::-webkit-details-marker {
		display: none;
	}
	.lt-display summary:hover,
	.lt-display[open] summary {
		border-color: var(--sl-color-gray-2);
		color: var(--sl-color-white);
	}
	.lt-display summary:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.lt-display-panel {
		position: absolute;
		inset-inline-end: 0;
		top: calc(100% + 0.5rem);
		z-index: 10;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 12rem;
		padding: 0.75rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background-color: var(--sl-color-bg-nav);
		box-shadow: var(--sl-shadow-md);
	}
	.lt-display-title {
		margin: 0;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}

	.lt-social {
		gap: 0.75rem;
		align-items: center;
	}

	/* Between tablet and wide screens: icon-only Display button to leave room. */
	@media (max-width: 60rem) {
		.lt-display-label {
			display: none;
		}
	}
</style>
