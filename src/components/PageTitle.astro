---
/**
 * Page title, extended:
 * - a colour-coded section label above the title, so you always know where you are;
 * - "Copy for AI" and "Markdown" buttons that hand the page to an AI assistant;
 * - the "At a glance" box from the `glance` front matter (time, level, what you need, where you'll work, result).
 */
// Same id as Starlight's own PageTitle (PAGE_TITLE_ID), which the table of contents links to.
const PAGE_TITLE_ID = '_top';
import { SECTION_NAMES, sectionOf } from '../lib/sections';

const { entry, id } = Astro.locals.starlightRoute;
const { title, glance, section: sectionOverride, draft } = entry.data;
const section = sectionOf(id, sectionOverride);
const markdownUrl = id && !draft ? `/${id}.md` : undefined;
/** Front matter text with `code`, **bold** and [links](/path/) written as Markdown. */
const inline = (text: string) =>
	text
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/`([^`]+)`/g, '<code>$1</code>')
		.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
		.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
/** How many of the three meter bars the level fills. */
const levelRank = { Beginner: 1, 'Some experience': 2, Advanced: 3 };
---

{
	section && (
		<p class="lt-eyebrow" data-section={section}>
			<span class="lt-dot" aria-hidden="true" />
			{SECTION_NAMES[section]}
		</p>
	)
}

<h1 id={PAGE_TITLE_ID}>{title}</h1>

{/* The section colour also tints step numbers and other accents further down the page. */}
{section && <script is:inline define:vars={{ section }}>document.documentElement.dataset.section = section;</script>}

{
	markdownUrl && (
		<div class="lt-page-tools not-content">
			<button type="button" class="lt-tool" data-copy-md={markdownUrl} aria-live="polite">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M16 1H6a2 2 0 0 0-2 2v12h2V3h10V1Zm3 4H10a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16h-9V7h9v14Z"/></svg>
				<span data-label>Copy page for AI</span>
			</button>
			<a class="lt-tool" href={markdownUrl} title="This page as plain Markdown, for AI assistants and tools">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M20.6 5H3.4C2.6 5 2 5.6 2 6.4v11.2c0 .8.6 1.4 1.4 1.4h17.2c.8 0 1.4-.6 1.4-1.4V6.4c0-.8-.6-1.4-1.4-1.4ZM12 16h-2v-4l-1.5 2L7 12v4H5V8h2l1.5 2L10 8h2v8Zm4.5.5L13.5 13H15V8h3v5h1.5l-3 3.5Z"/></svg>
				<span>Markdown</span>
			</a>
		</div>
	)
}

{
	glance && (
		<section class="lt-glance not-content" data-section={section} aria-labelledby="lt-glance-title">
			<header class="lt-glance-head">
				<h2 id="lt-glance-title" class="lt-glance-title">At a glance</h2>
				<div class="lt-glance-meta">
					{glance.minutes && (
						<p class="lt-chip">
							<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7Z"/></svg>
							<span class="lt-chip-label">Time</span>
							<span>{glance.maxMinutes ? `${glance.minutes}–${glance.maxMinutes} min` : `About ${glance.minutes} min`}</span>
						</p>
					)}
					{glance.level && (
						<p class="lt-chip">
							<span class="lt-meter" data-level={levelRank[glance.level]} aria-hidden="true"><i /><i /><i /></span>
							<span class="lt-chip-label">Level</span>
							<span>{glance.level}</span>
						</p>
					)}
				</div>
			</header>
			<div class="lt-glance-body">
				{glance.needs && glance.needs.length > 0 && (
					<div class="lt-glance-block">
						<h3 class="lt-block-title">
							<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm-9 14-5-5 1.4-1.4 3.6 3.6 7.6-7.6L19 8l-9 9Z"/></svg>
							You need
						</h3>
						<ul class="lt-needs">
							{glance.needs.map((need) => (
								<li set:html={inline(need)} />
							))}
						</ul>
					</div>
				)}
				{glance.where && glance.where.length > 0 && (
					<div class="lt-glance-block">
						<h3 class="lt-block-title">
							<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
							Where you'll work
						</h3>
						<ol class="lt-where">
							{glance.where.map((place) => (
								<li set:html={inline(place)} />
							))}
						</ol>
					</div>
				)}
				{glance.result && (
					<div class="lt-glance-block lt-result">
						<h3 class="lt-block-title">
							<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M14.4 6 14 4H5v17h2v-7h5.6l.4 2h7V6h-5.6Z"/></svg>
							At the end
						</h3>
						<p set:html={inline(glance.result)} />
					</div>
				)}
			</div>
		</section>
	)
}

<script>
	// "Copy page for AI": put the page's Markdown copy on the clipboard.
	document.querySelectorAll<HTMLButtonElement>('[data-copy-md]').forEach((button) => {
		const label = button.querySelector('[data-label]');
		const original = label?.textContent ?? '';
		const say = (text: string) => {
			if (!label) return;
			label.textContent = text;
			setTimeout(() => (label.textContent = original), 2500);
		};
		button.addEventListener('click', async () => {
			try {
				const response = await fetch(button.dataset.copyMd!);
				if (!response.ok) throw new Error(String(response.status));
				await navigator.clipboard.writeText(await response.text());
				say('Copied. Paste it into your AI chat');
			} catch {
				window.location.href = button.dataset.copyMd!;
			}
		});
	});
</script>

<style>
	h1 {
		margin-top: 0.25rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.lt-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1rem;
		padding: 0.15rem 0.7rem 0.15rem 0.55rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--lt-accent);
		background: color-mix(in srgb, var(--lt-accent) 13%, transparent);
	}
	.lt-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--lt-accent);
	}
	.lt-page-tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.85rem;
	}
	.lt-tool {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		cursor: pointer;
	}
	.lt-tool:hover,
	.lt-tool:focus-visible {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-3);
	}
	/* At a glance: a header strip (time, level), then "You need", "Where you'll work" and "At the end",
	   side by side when there's room and stacked when there isn't.
	   Everything is tinted with the section colour, so the box matches the page it sits on. */
	.lt-glance {
		margin-top: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--lt-accent) 35%, var(--sl-color-gray-5));
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-bg);
		container-type: inline-size;
	}
	.lt-glance-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 0.75rem 1rem;
		background: color-mix(in srgb, var(--lt-accent) 14%, var(--sl-color-bg));
		border-bottom: 1px solid color-mix(in srgb, var(--lt-accent) 30%, transparent);
	}
	.lt-glance-title {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--lt-accent);
	}
	.lt-glance-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.lt-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: var(--sl-color-bg);
		border: 1px solid color-mix(in srgb, var(--lt-accent) 40%, transparent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.lt-chip svg {
		color: var(--lt-accent);
	}
	.lt-chip-label {
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	.lt-meter {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.85rem;
	}
	.lt-meter i {
		width: 4px;
		border-radius: 1px;
		background: color-mix(in srgb, var(--lt-accent) 25%, transparent);
	}
	.lt-meter i:nth-child(1) { height: 40%; }
	.lt-meter i:nth-child(2) { height: 70%; }
	.lt-meter i:nth-child(3) { height: 100%; }
	.lt-meter[data-level='1'] i:nth-child(-n + 1),
	.lt-meter[data-level='2'] i:nth-child(-n + 2),
	.lt-meter[data-level='3'] i {
		background: var(--lt-accent);
	}
	.lt-glance-body {
		display: grid;
	}
	.lt-glance-block {
		padding: 0.85rem 1rem 1rem;
	}
	.lt-glance-block + .lt-glance-block {
		border-top: 1px solid var(--sl-color-gray-5);
	}
	/* Side by side once each block has room for a short line of text. */
	@container (width >= 40rem) {
		.lt-glance-body {
			grid-auto-flow: column;
			grid-auto-columns: 1fr;
		}
		.lt-glance-block + .lt-glance-block {
			border-top: 0;
			border-inline-start: 1px solid var(--sl-color-gray-5);
		}
	}
	.lt-block-title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--lt-accent);
	}
	.lt-needs {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lt-needs li {
		position: relative;
		padding-inline-start: 1.5rem;
		color: var(--sl-color-white);
	}
	.lt-needs li + li {
		margin-top: 0.4rem;
	}
	/* An empty tick box per item: "do I have this?" */
	.lt-needs li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.3em;
		width: 0.9rem;
		height: 0.9rem;
		border: 2px solid var(--lt-accent);
		border-radius: 0.2rem;
	}
	/* Numbered, because the order is the order you go there in. */
	.lt-where {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: lt-where;
	}
	.lt-where li {
		position: relative;
		padding-inline-start: 1.75rem;
		color: var(--sl-color-white);
		counter-increment: lt-where;
	}
	.lt-where li + li {
		margin-top: 0.4rem;
	}
	.lt-where li::before {
		content: counter(lt-where);
		position: absolute;
		inset-inline-start: 0;
		top: 0.15em;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 50%;
		background: var(--lt-accent);
		color: var(--sl-color-black);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.2rem;
		text-align: center;
	}
	.lt-result {
		background: color-mix(in srgb, var(--lt-accent) 7%, transparent);
	}
	.lt-result p {
		margin: 0;
		color: var(--sl-color-white);
	}
	.lt-glance :global(code) {
		font-size: 0.875em;
	}
</style>
