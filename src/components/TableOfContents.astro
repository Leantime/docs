---
/**
 * Starlight's "On this page" (wide screens only; narrow screens get Starlight's own dropdown)
 * with a button to hide it. Hidden, the column shrinks to a thin strip with the button, and the
 * text column gets the room. The choice is kept in this browser only; an inline script in the
 * page head (astro.config.mjs) applies it before the page paints, so the layout doesn't jump.
 */
import Default from '@astrojs/starlight/components/TableOfContents.astro';
---

<lt-toc class="lt-toc">
	<button type="button" class="lt-toc-toggle" aria-controls="lt-toc-body" aria-expanded="true">
		<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m9 6 6 6-6 6"></path>
		</svg>
		<span class="lt-toc-toggle-label">Hide</span>
	</button>
	<div id="lt-toc-body" class="lt-toc-body">
		<Default />
	</div>
</lt-toc>

<script>
	const KEY = 'lt-toc';

	class LtToc extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector<HTMLButtonElement>('.lt-toc-toggle');
			const label = this.querySelector<HTMLElement>('.lt-toc-toggle-label');
			if (!button || !label) return;

			const render = () => {
				const collapsed = document.documentElement.dataset.ltToc === 'collapsed';
				button.setAttribute('aria-expanded', String(!collapsed));
				button.setAttribute('aria-label', collapsed ? 'Show “On this page”' : 'Hide “On this page”');
				label.textContent = collapsed ? '' : 'Hide';
			};

			button.addEventListener('click', () => {
				const collapse = document.documentElement.dataset.ltToc !== 'collapsed';
				if (collapse) document.documentElement.dataset.ltToc = 'collapsed';
				else delete document.documentElement.dataset.ltToc;
				try {
					if (collapse) localStorage.setItem(KEY, 'collapsed');
					else localStorage.removeItem(KEY);
				} catch {
					// storage blocked: the choice lasts for this page only
				}
				render();
			});

			render();
		}
	}
	customElements.define('lt-toc', LtToc);
</script>

<style>
	.lt-toc {
		display: block;
		position: relative;
	}
	.lt-toc-toggle {
		position: absolute;
		top: 0.1rem;
		inset-inline-end: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.15rem 0.4rem;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		font: inherit;
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}
	.lt-toc-toggle:hover {
		border-color: var(--sl-color-gray-5);
		color: var(--sl-color-white);
	}
	.lt-toc-toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	/* Open: the arrow points right, "push it away". */
	.lt-toc-toggle svg {
		flex-shrink: 0;
	}
	/* Leave room for the button next to the "On this page" heading. */
	.lt-toc-body :global(h2) {
		padding-inline-end: 3.5rem;
	}

	/* Hidden: only the button, pointing left, "bring it back". */
	:global(:root[data-lt-toc='collapsed']) .lt-toc-body {
		display: none;
	}
	:global(:root[data-lt-toc='collapsed']) .lt-toc-toggle {
		position: static;
		padding: 0.35rem;
		border-color: var(--sl-color-gray-5);
	}
	:global(:root[data-lt-toc='collapsed']) .lt-toc-toggle svg {
		transform: rotate(180deg);
	}
</style>
